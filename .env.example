# Copy this to .env on the VPS and fill in real values.
# .env is gitignored — never commit it.

# Supabase project settings
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Analytics (optional — leave empty to disable completely)
# GA4: https://analytics.google.com → Property Settings → Measurement ID
VITE_GA_MEASUREMENT_ID=
# Umami: host the script yourself or use umami.is; both must be set together
VITE_UMAMI_SCRIPT_URL=
VITE_UMAMI_WEBSITE_ID=
